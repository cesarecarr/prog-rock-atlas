rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her kullanıcı yalnız kendi listelerini okuyup yazabilir.
    match /users/{uid}/lists/{listId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'created', 'items'])
        && request.resource.data.id == listId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3000;
    }
    // Başka her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
